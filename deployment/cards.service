
[Unit]
Description=Gunicorn instance to serve romwhist app
After=network.target

[Service]
User=pfajeau
WorkingDirectory=/home/pfajeau/dev/rom-whist
Environment="PATH=/home/pfajeau/dev/rom-whist/venv/bin"
ExecStart=/home/pfajeau/dev/rom-whist/venv/bin/gunicorn -k gthread --workers 1 --threads 100 -b :5000 romwhist:'create_app()'
[Install]
WantedBy=multi-user.target
